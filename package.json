{
  "name": "shots",
  "version": "0.1.0",
  "private": true,
  "description": "Scripted screenshots and journey videos of a web app, driven by Playwright",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "shots": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "pnpm build && vitest run test",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "peerDependencies": {
    "playwright": ">=1.59"
  },
  "dependencies": {
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "playwright": "1.61.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
